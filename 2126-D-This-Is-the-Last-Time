t=int(input())

for _ in range(t):
    n,k=map(int,input().split())
    arr=[tuple(map(int,input().split())) for _ in range(n)]
    
    arr.sort()
    used=[0]*n

    changed=True
    while changed:
        changed=False

        for i in range(n):
            l,r,real=arr[i]

            if not used[i] and l<=k<=r and real>k:
                k=real
                used[i]=1
                changed=True

    print(k)
